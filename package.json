{
  "name": "cord-field",
  "version": "3.0.0-dev",
  "scripts": {
    "start": "run-p \"start:*\"",
    "start:server": "vite",
    "start:gql-gen": "run-p \"gql-gen:* --watch\"",
    "dev": "vite",
    "build": "yarn gql-gen && rimraf build && yarn build:client && yarn build:server",
    "build:client": "NODE_ENV=production vite build",
    "build:server": "NODE_ENV=production vite build --ssr",
    "clean": "rimraf -g -v build node_modules/.vite 'src/**/*.generated.ts' 'src/{common,components,scenes}/**/*.graphql.ts' schema.graphql",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "yarn lint:check --fix",
    "lint:check": "eslint --ext .ts,.tsx --max-warnings 0 .",
    "type-check": "tsc -p .",
    "analyze": "ANALYZE=1 yarn build:client",
    "gql-gen": "yarn gql-gen:schema \"$@\" && yarn gql-gen:operations \"$@\"",
    "gql-gen:schema": "yarn gql-gen-base -c codegen.schema.yml",
    "gql-gen:operations": "yarn gql-gen-base -c codegen.operations.yml",
    "gql-gen-base": "TS_NODE_PROJECT=tsconfig.codegen.json graphql-codegen -r ts-node/register -r ./src/api/schema/codeGenUtil/loadEnv.codegen",
    "postinstall": "patch-typed-document-node || true; husky || true",
    "trigger-codepipeline": "rm -rf bin/dist && tsc -p bin && node bin/dist/start-codepipeline"
  },
  "engines": {
    "node": ">=24"
  },
